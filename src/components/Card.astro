---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { formatDate, getReadTime } from "@/utils/posts";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", ...post } = Astro.props;

const { id, data, filePath } = post;
const { title, description } = data;
---

<li>
  <a
    href={getPath(id, filePath)}
    class="flex flex-col gap-2 card p-[22px_24px] text-foreground hover:border-border-hover"
  >
    <span class="text-[13px] text-muted">
      {formatDate(post)} · {getReadTime(post)}
    </span>
    <Heading
      class="m-0 font-serif text-xl leading-snug font-medium"
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
    <p class="m-0 text-[15px] leading-[1.6] text-soft">{description}</p>
  </a>
</li>
