---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { formatDate, getBanner, getReadTime } from "@/utils/posts";

type Props = {
  variant?: "h2" | "h3";
  /** Show the post description under the title */
  showDescription?: boolean;
  class?: string;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  showDescription = false,
  class: className,
  ...post
} = Astro.props;

const { id, data, filePath } = post;
const { title, description } = data;
const banner = getBanner(post);
---

<li class={className}>
  <a
    href={getPath(id, filePath)}
    class="group flex h-full flex-col overflow-hidden card text-foreground hover:border-border-hover"
  >
    <div class="overflow-hidden bg-well">
      {
        banner ? (
          <Image
            src={banner}
            alt=""
            width={600}
            class="aspect-[3/2] w-full object-cover transition-[scale] duration-500 group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
          />
        ) : (
          /* No banner: dot pattern with the first tag, so the card keeps its shape */
          <div class="flex aspect-[3/2] w-full items-center justify-center bg-[radial-gradient(var(--dot)_1px,transparent_1px)] [background-size:14px_14px]">
            {/* Same look as the small <Tag> pill, but not a link (the whole card is one) */}
            <span class="inline-flex items-center gap-1 rounded-full border border-border-strong bg-surface px-3 py-1 text-[13px] text-soft">
              <span class="font-mono text-muted">#</span>
              {data.tags[0]}
            </span>
          </div>
        )
      }
    </div>
    <div class="flex flex-col gap-2.5 px-5 pt-[18px] pb-[22px]">
      <span class="text-[13px] text-muted">
        {formatDate(post)} · {getReadTime(post)}
      </span>
      <Heading
        class="m-0 font-serif text-[19px] leading-[1.35] font-medium text-pretty"
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      >
        {title}
      </Heading>
      {
        showDescription && (
          <p class="m-0 line-clamp-3 text-[15px] leading-[1.6] text-soft">
            {description}
          </p>
        )
      }
    </div>
  </a>
</li>
