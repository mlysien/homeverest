---
/**
 * Hand-drawn pen underline: a main stroke plus a fainter second pass.
 * It stretches to whatever box `class` gives it while keeping the line weight.
 */
type Props = {
  class?: string;
  /** Main stroke width in px; the second pass is half of it */
  weight?: number;
};

const { class: className, weight = 4 } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 200 14"
  preserveAspectRatio="none"
  class:list={["pointer-events-none overflow-visible text-accent", className]}
>
  <path
    d="M3 9 C 30 5.5, 70 5, 110 6.2 S 175 8.5, 197 4.5"
    fill="none"
    stroke="currentColor"
    stroke-width={weight}
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
  <path
    d="M12 11.5 C 60 9, 120 9.5, 186 8"
    fill="none"
    stroke="currentColor"
    stroke-width={weight / 2}
    stroke-linecap="round"
    opacity="0.55"
    vector-effect="non-scaling-stroke"></path>
</svg>
