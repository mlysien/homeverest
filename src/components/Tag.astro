---
type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 rounded-full border border-border-strong text-soft transition-colors",
      "hover:border-accent hover:text-foreground",
      { "px-3 py-1 text-[13px]": size === "sm" },
      { "px-3.5 py-2 text-sm": size === "lg" },
    ]}
  >
    <span class="font-mono text-muted">#</span>{tagName}
  </a>
</li>
