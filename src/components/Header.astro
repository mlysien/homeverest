---
import { SITE } from "@/config";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";

const { pathname } = Astro.url;

const NAV = [
  { href: "/", label: "Wpisy", match: ["/", "/posts", "/tags", "/search"] },
  { href: "/projects", label: "Projekty", match: ["/projects"] },
  { href: "/media", label: "Media", match: ["/media"] },
  { href: "/photography", label: "Fotografia", match: ["/photography"] },
  { href: "/about", label: "O mnie", match: ["/about"] },
];

const isActive = (match: string[]) =>
  match.some(path =>
    path === "/" ? pathname === "/" : pathname.startsWith(path)
  );
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-md bg-surface px-3 py-2 text-accent-soft transition-all focus:top-4"
>
  Przejdź do treści
</a>

<header class="flex flex-wrap items-center justify-between gap-5 py-8">
  <a
    href="/"
    class="group relative inline-block pb-1 text-2xl leading-none font-semibold tracking-[-0.02em] text-foreground [text-shadow:0_1px_3px_rgb(0_0_0/0.75)]"
  >
    <!-- Bold underline bar with rounded ends, like the buttons -->
    <span
      aria-hidden="true"
      class="absolute inset-x-0 -bottom-1 h-[6px] rounded-full bg-accent transition-colors group-hover:bg-accent-soft"
    ></span>
    <span class="relative">{SITE.title}</span>
  </a>
  <button
    id="menu-btn"
    type="button"
    aria-label="Otwórz menu"
    aria-expanded="false"
    aria-controls="main-nav"
    class="-me-2 p-2 text-muted transition-colors hover:text-foreground md:hidden"
  >
    <IconMenuDeep id="menu-icon" class="size-6" />
    <IconX id="close-icon" class="hidden size-6" />
  </button>
  <nav
    id="main-nav"
    aria-label="Główna nawigacja"
    class="hidden w-full md:block md:w-auto"
  >
    <ul
      class="flex flex-col gap-1 border-t border-border pt-3 md:flex-row md:flex-wrap md:items-center md:gap-x-[22px] md:gap-y-2 md:border-0 md:pt-0"
    >
      {
        NAV.map(({ href, label, match }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(match) ? "page" : undefined}
              class:list={[
                "block w-fit border-b border-transparent py-2.5 text-base text-muted transition-colors hover:text-foreground md:py-1 md:text-sm",
                { "active-nav": isActive(match) },
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function initMenu() {
    const btn = document.querySelector("#menu-btn");
    const nav = document.querySelector("#main-nav");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    if (!btn || !nav || !menuIcon || !closeIcon) return;

    btn.addEventListener("click", () => {
      const open = nav.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Zamknij menu" : "Otwórz menu");
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    });
  }

  document.addEventListener("astro:page-load", initMenu);
</script>
