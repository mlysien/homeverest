---
import { SITE } from "@/config";

const { pathname } = Astro.url;

const NAV = [
  { href: "/", label: "Writing", match: ["/", "/posts", "/tags", "/search"] },
  { href: "/projects", label: "Projects", match: ["/projects"] },
  { href: "/media", label: "Media", match: ["/media"] },
  { href: "/photography", label: "Photography", match: ["/photography"] },
  { href: "/about", label: "About", match: ["/about"] },
];

const isActive = (match: string[]) =>
  match.some(path =>
    path === "/" ? pathname === "/" : pathname.startsWith(path)
  );
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-md bg-surface px-3 py-2 text-accent-soft transition-all focus:top-4"
>
  Skip to content
</a>

<header class="flex flex-wrap items-center justify-between gap-5 py-8">
  <a
    href="/"
    class="group relative inline-block pb-1 text-[19px] leading-none font-semibold tracking-[-0.02em] text-foreground [text-shadow:0_1px_3px_rgb(0_0_0/0.75)]"
  >
    <!-- Hand-drawn pen underline, stretched to the word's width -->
    <svg
      aria-hidden="true"
      viewBox="0 0 200 14"
      preserveAspectRatio="none"
      class="pointer-events-none absolute -right-1 -bottom-1.5 -left-1 h-3.5 w-[calc(100%+8px)] text-accent transition-colors group-hover:text-accent-soft"
    >
      <path
        d="M3 9 C 30 5.5, 70 5, 110 6.2 S 175 8.5, 197 4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"></path>
      <path
        d="M12 11.5 C 60 9, 120 9.5, 186 8"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        opacity="0.55"
        vector-effect="non-scaling-stroke"></path>
    </svg>
    <span class="relative">{SITE.title}</span>
  </a>
  <nav aria-label="Main">
    <ul class="flex flex-wrap items-center gap-x-[22px] gap-y-2">
      {
        NAV.map(({ href, label, match }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(match) ? "page" : undefined}
              class:list={[
                "block border-b border-transparent py-1 text-sm text-muted transition-colors hover:text-foreground",
                { "active-nav": isActive(match) },
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
