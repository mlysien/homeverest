---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex items-center gap-3 text-sm text-muted">
      <span>Udostępnij wpis</span>
      <div class="flex gap-1">
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href + URL}`}
            class="rounded-full border border-border-strong p-2 text-subtle transition-colors hover:border-accent hover:text-foreground"
            title={social.linkTitle}
          >
            <social.icon class="inline-block size-4 fill-transparent stroke-current stroke-2" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
