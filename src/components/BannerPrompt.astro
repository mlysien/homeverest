---
/*
 * Caption under a post banner with a link to the AI prompt that generated it.
 * The prompt opens in a dialog with a copy button.
 *
 * No <pre> or <h2> inside the dialog on purpose: PostDetails attaches copy
 * buttons to every <pre> and anchor links to every heading.
 */
type Props = {
  prompt: string;
};

const { prompt } = Astro.props;
---

<figcaption
  class="mt-3 flex flex-wrap items-center gap-x-2 text-[13px] text-muted"
  data-pagefind-ignore
>
  <span>Baner wygenerowany przez AI</span>
  <span aria-hidden="true">·</span>
  <button
    type="button"
    data-prompt-open
    aria-haspopup="dialog"
    class="cursor-pointer text-accent-soft underline decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-strong hover:decoration-accent"
  >
    Zobacz prompt
  </button>
</figcaption>

<dialog
  data-prompt-dialog
  aria-labelledby="banner-prompt-title"
  data-pagefind-ignore
  class="m-auto w-[min(640px,calc(100vw-32px))] max-w-none rounded-2xl border border-border-strong bg-surface p-0 text-foreground shadow-2xl backdrop:bg-[#0b0c10]/70 backdrop:backdrop-blur-sm"
>
  <div class="flex max-h-[80dvh] flex-col">
    <div
      class="flex items-center justify-between gap-4 border-b border-border px-5 py-4"
    >
      <p id="banner-prompt-title" class="m-0 font-serif text-lg font-medium">
        Prompt użyty do wygenerowania banera
      </p>
      <button
        type="button"
        data-prompt-close
        aria-label="Zamknij"
        class="size-9 shrink-0 rounded-full border border-border-strong text-base text-subtle transition-colors hover:border-accent hover:text-foreground"
        >✕</button
      >
    </div>

    <div
      data-prompt-text
      class="min-h-0 flex-1 overflow-y-auto bg-surface-sunken px-5 py-4 font-mono text-sm leading-relaxed whitespace-pre-wrap text-prose"
      set:text={prompt.trim()}
    />

    <div class="flex justify-end border-t border-border px-5 py-3">
      <button
        type="button"
        data-prompt-copy
        class="rounded-full border border-border-strong px-4 py-1.5 text-sm text-subtle transition-colors hover:border-accent hover:text-foreground"
      >
        Kopiuj prompt
      </button>
    </div>
  </div>
</dialog>

<script>
  function initBannerPrompt() {
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-prompt-dialog]"
    );
    const openButton = document.querySelector("[data-prompt-open]");
    if (!dialog || !openButton) return;

    const $ = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const text = $<HTMLElement>("[data-prompt-text]");
    const copy = $<HTMLButtonElement>("[data-prompt-copy]");
    const copyLabel = copy.textContent!.trim();

    openButton.addEventListener("click", () => dialog.showModal());
    $("[data-prompt-close]").addEventListener("click", () => dialog.close());

    // Click on the backdrop closes the dialog
    dialog.addEventListener("click", e => {
      if (e.target === dialog) dialog.close();
    });

    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(text.textContent!.trim());
      copy.textContent = "Skopiowano ✓";
      setTimeout(() => (copy.textContent = copyLabel), 1500);
    });
  }

  document.addEventListener("astro:page-load", initBannerPrompt);
</script>
