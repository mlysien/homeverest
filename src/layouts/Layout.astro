---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import { PHOTO_LINKS, SOCIALS } from "@/constants";
import avatar from "@/assets/about/avatar.jpeg";
import "@/styles/global.css";

type Props = {
  title?: string;
  /** Post title without the site suffix, used as the BlogPosting headline */
  headline?: string;
  /** schema.org type of the page node in JSON-LD */
  schemaType?: "WebPage" | "ProfilePage" | "CollectionPage";
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** Long-form reading page: denser column, short doodle fade on mobile */
  reading?: boolean;
};

const {
  title = SITE.title,
  headline,
  schemaType = "WebPage",
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  reading = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

/* ========== JSON-LD Structured data ========== */

const siteURL = new URL("/", SITE.website).href;
const pageURL = new URL(canonicalURL).href;
const ids = {
  website: `${siteURL}#website`,
  person: `${siteURL}#person`,
  blog: `${siteURL}posts/#blog`,
  page: `${pageURL}#webpage`,
  breadcrumb: `${pageURL}#breadcrumb`,
};

const website = {
  "@type": "WebSite",
  "@id": ids.website,
  url: siteURL,
  name: SITE.title,
  description: SITE.desc,
  inLanguage: SITE.lang,
  publisher: { "@id": ids.person },
};

const person = {
  "@type": "Person",
  "@id": ids.person,
  name: SITE.author,
  url: SITE.profile,
  image: new URL(avatar.src, SITE.website).href,
  jobTitle: "Software System Engineer",
  sameAs: [...SOCIALS, ...PHOTO_LINKS]
    .map(({ href }) => href)
    .filter(href => href.startsWith("http")),
};

const webPage = {
  "@type": schemaType,
  "@id": ids.page,
  url: pageURL,
  name: title,
  description,
  inLanguage: SITE.lang,
  isPartOf: { "@id": ids.website },
  primaryImageOfPage: { "@type": "ImageObject", url: `${socialImageURL}` },
  ...(schemaType === "ProfilePage" && { mainEntity: { "@id": ids.person } }),
};

const postNodes = pubDatetime
  ? [
      {
        "@type": "BlogPosting",
        "@id": `${pageURL}#article`,
        mainEntityOfPage: { "@id": ids.page },
        isPartOf: { "@id": ids.blog },
        headline: headline ?? title,
        description,
        image: `${socialImageURL}`,
        inLanguage: SITE.lang,
        datePublished: pubDatetime.toISOString(),
        dateModified: (modDatetime ?? pubDatetime).toISOString(),
        author: {
          "@type": "Person",
          ...(author === SITE.author && { "@id": ids.person }),
          name: author,
          url: profile,
        },
        publisher: { "@id": ids.person },
      },
      {
        "@type": "Blog",
        "@id": ids.blog,
        url: new URL("posts/", siteURL).href,
        name: SITE.title,
        isPartOf: { "@id": ids.website },
        publisher: { "@id": ids.person },
      },
      {
        "@type": "BreadcrumbList",
        "@id": ids.breadcrumb,
        itemListElement: [
          { name: "Strona główna", item: siteURL },
          { name: "Wpisy", item: new URL("posts/", siteURL).href },
          { name: headline ?? title, item: pageURL },
        ].map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          ...crumb,
        })),
      },
    ]
  : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    website,
    person,
    {
      ...webPage,
      ...(pubDatetime && { breadcrumb: { "@id": ids.breadcrumb } }),
    },
    ...postNodes,
  ],
};
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Font -->
    <Font
      cssVariable="--font-literata"
      preload={[{ subset: "latin", weight: 500, style: "normal" }]}
    />
    <Font
      cssVariable="--font-geist"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "ddee546674dc4abebc047a4191a2ec22"}'></script>
    <!-- End Cloudflare Web Analytics -->

    <meta name="theme-color" content="#111318" />

    <!-- Theme: saved choice, else the system preference. Runs before first paint -->
    <script is:inline>
      (() => {
        const COLORS = { dark: "#111318", light: "#e4e7eb" };

        function getTheme() {
          try {
            const saved = localStorage.getItem("theme");
            if (saved === "light" || saved === "dark") return saved;
          } catch {}
          return matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }

        function applyTheme(doc = document) {
          const theme = getTheme();
          doc.documentElement.dataset.theme = theme;
          doc
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", COLORS[theme]);
        }

        applyTheme();
        window.applyTheme = applyTheme;

        // View transitions replace <html> attributes; set the theme on the incoming page
        if (!window.__themeSwapHook) {
          window.__themeSwapHook = true;
          document.addEventListener("astro:before-swap", e =>
            applyTheme(e.newDocument)
          );
        }
      })();
    </script>

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <div class="app-shell" data-reading={reading || undefined}>
      <slot />
    </div>
  </body>
</html>
