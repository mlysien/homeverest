---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import {
  formatDate,
  getBanner,
  getReadTime,
  pluralizePosts,
} from "@/utils/posts";
import { slugifyStr } from "@/utils/slugify";

const posts = getSortedPosts(await getCollection("blog"));
const [latest] = posts;
const latestBanner = getBanner(latest);
const latestPath = getPath(latest.id, latest.filePath);
// The latest post is featured in the hero, so the carousel starts from the next one.
// Its last slot is a "Show all" card linking to the full list.
const recentPosts = posts.slice(1, 6);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    class="flex flex-col gap-[88px] pt-12 pb-24"
  >
    <section
      id="hero"
      class="grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] md:gap-12"
    >
      <div class="flex flex-col gap-5">
        <span
          class="font-mono text-[11px] tracking-[0.16em] text-muted uppercase"
        >
          Najnowszy wpis
          {
            latest.data.tags[0] && (
              <>
                ·{" "}
                <a
                  href={`/tags/${slugifyStr(latest.data.tags[0])}/`}
                  class="text-accent-soft hover:text-accent-strong"
                >
                  {latest.data.tags[0]}
                </a>
              </>
            )
          }
        </span>
        <h1
          class="m-0 font-serif text-[clamp(30px,4.4vw,44px)] leading-[1.15] font-medium tracking-[-0.015em] text-balance"
        >
          <a href={latestPath} class="text-foreground hover:text-accent-soft">
            {latest.data.title}
          </a>
        </h1>
        <span class="text-sm text-muted">
          <time datetime={latest.data.pubDatetime.toISOString()}>
            {formatDate(latest)}
          </time>
          · {getReadTime(latest)}
        </span>
        <p class="m-0 font-serif text-lg leading-[1.7] text-pretty text-subtle">
          {latest.data.description}
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <a
            href={latestPath}
            class="group inline-flex items-center gap-2 rounded-[10px] bg-accent px-5 py-3 text-[15px] font-medium text-background transition-colors hover:bg-accent-soft"
          >
            Czytaj wpis
            <IconArrowRight
              class="size-[18px] transition-transform group-hover:translate-x-0.5 rtl:rotate-180"
            />
          </a>
        </div>
      </div>
      <a
        href={latestPath}
        aria-hidden="true"
        tabindex="-1"
        class="group block overflow-hidden rounded-2xl border border-border bg-surface max-md:order-first"
      >
        {
          latestBanner ? (
            <Image
              src={latestBanner}
              alt=""
              widths={[600, 900, 1200]}
              sizes="(max-width: 768px) 100vw, 480px"
              class="aspect-[3/2] w-full object-cover transition-[scale] duration-500 group-hover:scale-[1.02]"
              loading="eager"
            />
          ) : (
            <div class="aspect-[3/2] w-full" />
          )
        }
      </a>
    </section>

    <section id="recent-posts" class="flex flex-col gap-6" data-carousel>
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <h2 class="m-0 font-serif text-[26px] font-medium">Ostatnie wpisy</h2>
        <div class="flex gap-1.5">
          <button
            data-carousel-prev
            aria-label="Poprzednie"
            class="flex size-11 items-center justify-center rounded-full border border-border bg-surface text-subtle transition-colors hover:border-accent hover:text-foreground"
          >
            <IconArrowLeft class="size-[18px] rtl:rotate-180" />
          </button>
          <button
            data-carousel-next
            aria-label="Następne"
            class="flex size-11 items-center justify-center rounded-full border border-border bg-surface text-subtle transition-colors hover:border-accent hover:text-foreground"
          >
            <IconArrowRight class="size-[18px] rtl:rotate-180" />
          </button>
          <a
            href="/posts/"
            aria-label="Wszystkie wpisy"
            title="Wszystkie wpisy"
            class="ms-3 flex size-11 items-center justify-center rounded-full border border-border bg-surface text-subtle transition-colors hover:border-accent hover:text-foreground"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="size-4 fill-current"
            >
              <rect x="1" y="1" width="6" height="6" rx="1.5"></rect>
              <rect x="9" y="1" width="6" height="6" rx="1.5"></rect>
              <rect x="1" y="9" width="6" height="6" rx="1.5"></rect>
              <rect x="9" y="9" width="6" height="6" rx="1.5"></rect>
            </svg>
          </a>
        </div>
      </div>
      <ul
        data-carousel-track
        class="bleed no-scrollbar flex snap-x snap-mandatory scroll-px-(--gutter) gap-4 overflow-x-auto px-(--gutter) lg:[mask-image:linear-gradient(to_right,transparent,black_var(--gutter),black_calc(100%-var(--gutter)),transparent)]"
      >
        {
          recentPosts.map(post => (
            <Card
              {...post}
              variant="h3"
              class="w-[min(300px,76vw)] flex-none snap-start lg:w-[calc((100%-2rem)/3)]"
            />
          ))
        }
        <li
          class="w-[min(300px,76vw)] flex-none snap-start lg:w-[calc((100%-2rem)/3)]"
        >
          <a
            href="/posts/"
            class="group flex h-full min-h-[300px] flex-col items-center justify-center gap-4 card border-dashed border-border-strong p-6 text-center text-foreground hover:border-solid hover:border-accent"
          >
            <span
              class="flex size-14 items-center justify-center rounded-full border border-border-strong bg-surface-sunken text-subtle transition-colors group-hover:border-accent group-hover:bg-accent group-hover:text-background"
            >
              <IconArrowRight class="size-6 rtl:rotate-180" />
            </span>
            <span class="font-serif text-[22px] font-medium"
              >Pokaż wszystkie</span
            >
            <span class="text-[13px] text-muted"
              >{pluralizePosts(posts.length)}</span
            >
          </a>
        </li>
      </ul>
      <div class="flex justify-center gap-1.5">
        {
          [...recentPosts, null].map((post, i) => (
            <button
              data-carousel-dot={i}
              aria-label={
                post
                  ? `Przejdź do wpisu ${i + 1}`
                  : "Przejdź do wszystkich wpisów"
              }
              class:list={[
                "size-1.5 rounded-full p-0 transition-colors",
                i === 0 ? "bg-accent" : "bg-dot",
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-2.5 card p-7">
      <h2 class="m-0 font-serif text-xl font-medium">Bądź na bieżąco</h2>
      <p class="m-0 text-[15px] leading-[1.6] text-soft">
        Nowe wpisy trafiają do kanału RSS zaraz po publikacji. Dodaj go do
        swojego ulubionego czytnika.
      </p>
      <div class="flex flex-wrap gap-2 pt-2">
        <a
          href="/rss.xml"
          class="rounded-[10px] bg-accent px-5 py-3 text-[15px] font-medium text-background transition-colors hover:bg-accent-soft"
        >
          Subskrybuj przez RSS
        </a>
        <a
          href="/tags"
          class="rounded-[10px] border border-border-strong px-5 py-3 text-[15px] text-foreground transition-colors hover:border-accent"
        >
          Przeglądaj tagi
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initCarousel() {
    const root = document.querySelector<HTMLElement>("[data-carousel]");
    const track = root?.querySelector<HTMLElement>("[data-carousel-track]");
    if (!root || !track) return;

    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")
    );
    const last = dots.length - 1;
    let active = 0;

    const step = () => {
      const card = track.querySelector("li");
      return card ? card.offsetWidth + 16 : 316;
    };

    const goTo = (i: number) =>
      track.scrollTo({ left: i * step(), behavior: "smooth" });

    const setActive = (i: number) => {
      if (i === active) return;
      dots[active]?.classList.replace("bg-accent", "bg-dot");
      dots[i]?.classList.replace("bg-dot", "bg-accent");
      active = i;
    };

    track.addEventListener(
      "scroll",
      () => {
        const max = track.scrollWidth - track.clientWidth;
        setActive(
          track.scrollLeft >= max - 4
            ? last
            : Math.round(track.scrollLeft / step())
        );
      },
      { passive: true }
    );

    root
      .querySelector("[data-carousel-prev]")
      ?.addEventListener("click", () => goTo(Math.max(0, active - 1)));
    root
      .querySelector("[data-carousel-next]")
      ?.addEventListener("click", () => goTo(Math.min(last, active + 1)));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  }

  document.addEventListener("astro:page-load", () => {
    initCarousel();
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
