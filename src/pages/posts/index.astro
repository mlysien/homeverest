---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostsByYear from "@/components/PostsByYear.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { pluralizePosts } from "@/utils/posts";
import { SITE } from "@/config";

const posts = getSortedPosts(await getCollection("blog"));
---

<Layout title={`Wszystkie wpisy | ${SITE.title}`} schemaType="CollectionPage">
  <Header />
  <Main
    pageTitle="Wszystkie wpisy"
    pageDesc={`Wszystko, co opublikowałem, od najnowszych. Do tej pory: ${pluralizePosts(posts.length)}.`}
  >
    <div class="flex flex-col gap-10 pt-4">
      <PostsByYear posts={posts} />
    </div>
  </Main>
  <Footer />
</Layout>
