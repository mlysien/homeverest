---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageTitle from "@/components/PageTitle.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />
  <main
    id="main-content"
    class="flex flex-1 flex-col items-start justify-center gap-4 py-24"
  >
    <span class="font-mono text-[13px] tracking-[0.16em] text-muted uppercase"
      >404</span
    >
    <PageTitle>Page not found</PageTitle>
    <p class="page-lead">That page doesn't exist, or it moved.</p>
    <a href="/" class="mt-2 link">← Back to all writing</a>
  </main>
  <Footer />
</Layout>
