---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageTitle from "@/components/PageTitle.astro";
import portrait from "@/assets/about/avatar.jpeg";
import { SOCIALS } from "@/constants";
import { SITE } from "@/config";

const RESUME = "/mlysien.cv.pl.pdf";

const EXPERIENCE = [
  {
    period: "2022 — obecnie",
    role: "Software System Engineer",
    company: "Beumer Group",
    href: "https://www.beumergroup.com/",
    desc: "Aplikacja produktowa dla systemu Pouch Sorter, tworzona w międzynarodowym zespole. Backendowe API oraz komponenty UI w Angularze.",
    stack: ".NET · Kotlin · Spring · Angular · PostgreSQL",
  },
  {
    period: "2020 — 2022",
    role: "Fullstack Software Developer",
    company: "Onex Group",
    href: "https://onex.group/",
    desc: "Wewnętrzna aplikacja webowa do zarządzania przydziałem licencji Microsoft dla klientów.",
    stack: "C# · ASP.NET Core · EF Core · JavaScript",
  },
  {
    period: "2017 — 2020",
    role: "Software Developer",
    company: "merce.com",
    href: "https://merce.com",
    desc: "Desktopowa aplikacja integracyjna synchronizująca systemy ERP z hybrydową platformą e-commerce.",
    stack: "C# · WinForms · WPF · REST · WSDL",
  },
  {
    period: "2015 — 2017",
    role: "Mobile Developer",
    company: "AIUT",
    href: "https://aiut.com/",
    desc: "Aplikacja na Androida komunikująca się przez Bluetooth z urządzeniami wbudowanymi, wraz z usługami webowymi.",
    stack: "C# · Xamarin · WCF",
  },
];

const EDUCATION = [
  {
    period: "2016 — 2018",
    title: "Magister inżynier",
    school: "Politechnika Śląska, Gliwice",
  },
  {
    period: "2012 — 2016",
    title: "Inżynier",
    school: "Politechnika Śląska, Gliwice",
  },
];
---

<Layout title={`O mnie | ${SITE.title}`} schemaType="ProfilePage">
  <Header />
  <main id="main-content" class="flex flex-col gap-8 pt-12 pb-24">
    <!-- Profile header: title on top like every other page; lead and bio beside the portrait, same height -->
    <header
      class="grid sm:grid-cols-[minmax(0,1fr)_220px] sm:gap-x-10 md:grid-cols-[minmax(0,1fr)_300px]"
    >
      <div class="sm:col-span-2">
        <PageTitle>O mnie</PageTitle>
      </div>
      <p class="page-lead mt-3.5">
        {EXPERIENCE[0].role} w {EXPERIENCE[0].company}.
      </p>
      {
        /* Out of flow on desktop, so the text alone sets the row height and the photo fills it */
      }
      <div
        class="relative mt-8 aspect-[4/3] overflow-hidden rounded-2xl bg-surface sm:col-start-2 sm:row-span-2 sm:row-start-2 sm:mt-3.5 sm:aspect-auto"
      >
        <Image
          src={portrait}
          alt="Mateusz Łysień"
          widths={[440, 660, 880]}
          sizes="(max-width: 640px) 100vw, 300px"
          class="absolute inset-0 !h-full w-full"
          loading="eager"
        />
      </div>
      <div
        class="mt-8 flex flex-col gap-5 font-serif text-[19px] leading-[1.75] text-prose [&_p]:m-0 [&_p]:text-pretty"
      >
        <p>
          Jestem Mateusz Łysień, programista z korzeniami w .NET, wzrokiem
          zwróconym ku kosmosowi i nawykiem budowania rzeczy tylko po to, żeby
          sprawdzić, czy dam radę.
        </p>
        <p>
          Moja droga prowadziła od WinForms i WPF, przez ASP.NET Core i
          Angulara, aż po Kotlina w międzynarodowym projekcie z branży
          intralogistyki. Nauczyła mnie, że język programowania to tylko
          narzędzie. Liczy się to, jak myślisz o problemach.
        </p>
        <p>
          Dziś coraz częściej piszę kod razem z asystentami AI. Na blogu
          opisuję, jak buduję z nimi prawdziwe narzędzia, gdzie ta współpraca
          zgrzyta i dlaczego decyzje architektoniczne wciąż należą do człowieka.
        </p>
      </div>
    </header>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <a
        href={RESUME}
        target="_blank"
        class="flex items-center justify-center rounded-[10px] bg-accent px-3 py-3 text-center text-[15px] font-medium text-background transition-colors hover:bg-accent-soft"
      >
        Pobierz CV<span class="max-sm:hidden">&nbsp;(PDF)</span>
      </a>
      {
        SOCIALS.map(social => (
          <a
            href={social.href}
            target={social.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            title={social.linkTitle}
            class="flex items-center justify-center gap-2 rounded-[10px] border border-border-strong px-4 py-3 text-[15px] text-foreground transition-colors hover:border-accent"
          >
            <social.icon class="size-[18px] fill-transparent stroke-current stroke-2 text-subtle" />
            {social.name}
          </a>
        ))
      }
    </div>

    <section class="flex flex-col gap-2 pt-8">
      <h2 class="m-0 font-serif text-[26px] font-medium">Doświadczenie</h2>
      <ol class="flex flex-col">
        {
          EXPERIENCE.map(job => (
            <li class="grid grid-cols-[minmax(0,120px)_minmax(0,1fr)] gap-5 border-t border-border py-5 max-sm:grid-cols-1 max-sm:gap-1.5">
              <span class="pt-[3px] font-mono text-[13px] text-muted">
                {job.period}
              </span>
              <div class="flex flex-col gap-1.5">
                <span class="font-serif text-[19px]">
                  {job.role}
                  <span class="text-muted"> @ </span>
                  <a
                    href={job.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                  >
                    {job.company}
                  </a>
                </span>
                <p class="m-0 text-[15px] leading-[1.6] text-soft">
                  {job.desc}
                </p>
                <span class="text-[13px] text-muted">{job.stack}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="flex flex-col gap-2 pt-4">
      <h2 class="m-0 font-serif text-[26px] font-medium">Wykształcenie</h2>
      <ol class="flex flex-col">
        {
          EDUCATION.map(edu => (
            <li class="grid grid-cols-[minmax(0,120px)_minmax(0,1fr)] gap-5 border-t border-border py-5 max-sm:grid-cols-1 max-sm:gap-1.5">
              <span class="pt-[3px] font-mono text-[13px] text-muted">
                {edu.period}
              </span>
              <div class="flex flex-col gap-1">
                <span class="font-serif text-[19px]">{edu.title}</span>
                <span class="text-sm text-muted">{edu.school}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer />
</Layout>
