---
import { Image, getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PhotoViewer from "@/components/PhotoViewer.astro";
import { PHOTOS } from "@/content-data/photos";
import { SITE } from "@/config";
import { PHOTO_LINKS } from "@/constants";

// Large, web-friendly version for the viewer; the untouched file is linked as "Original"
const photos = await Promise.all(
  PHOTOS.map(async photo => {
    const large = await getImage({
      src: photo.src,
      width: Math.min(2560, photo.src.width),
      format: "webp",
    });
    return { ...photo, large: large.src, original: photo.src.src };
  })
);
---

<Layout title={`Fotografia | ${SITE.title}`} schemaType="CollectionPage">
  <Header />
  <Main
    pageTitle="Fotografia"
    pageDesc="Fotografia to jedno z moich ulubionych zajęć, lubię łapać momenty przez obiektyw aparatu. Oto kilka z nich, które najbardziej lubię."
  >
    <div class="-mt-3 grid grid-cols-2 gap-2 sm:gap-3">
      {
        PHOTO_LINKS.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            title={link.linkTitle}
            class="group flex w-full items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 transition-colors hover:border-accent"
          >
            <link.icon class="size-6 shrink-0 text-subtle transition-colors group-hover:text-accent" />
            <span class="text-[15px] text-foreground">{link.cta}</span>
          </a>
        ))
      }
    </div>
    {
      photos.length === 0 && (
        <p class="m-0 text-[15px] text-muted">Nie ma jeszcze zdjęć.</p>
      )
    }
    <div class="columns-2 gap-2 sm:gap-3">
      {
        photos.map((photo, i) => (
          <figure class="m-0 mb-2 flex break-inside-avoid flex-col gap-1.5 sm:mb-3 sm:gap-2">
            <button
              data-photo={i}
              data-large={photo.large}
              data-original={photo.original}
              data-caption={photo.caption}
              aria-label={`Otwórz zdjęcie: ${photo.caption}`}
              class="block cursor-zoom-in rounded-xl p-0"
            >
              <Image
                src={photo.src}
                alt={`Zdjęcie: ${photo.caption}`}
                widths={[320, 452, 904]}
                sizes="(max-width: 1000px) calc(50vw - 26px), 452px"
                quality={70}
                loading={i < 2 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                class="w-full rounded-xl bg-surface"
              />
            </button>
            <figcaption class="pb-1.5 text-xs text-muted sm:text-[13px]">
              {photo.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Main>
  <Footer />

  <PhotoViewer />
</Layout>
