---
import { Image, getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PhotoViewer from "@/components/PhotoViewer.astro";
import { PHOTOS } from "@/content-data/photos";
import { SITE } from "@/config";

// Large, web-friendly version for the viewer; the untouched file is linked as "Original"
const photos = await Promise.all(
  PHOTOS.map(async photo => {
    const large = await getImage({
      src: photo.src,
      width: Math.min(2560, photo.src.width),
      format: "webp",
    });
    return { ...photo, large: large.src, original: photo.src.src };
  })
);
---

<Layout title={`Fotografia | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Fotografia"
    pageDesc="Poza kodem lubię uchwycić świat przez obiektyw. Oto kilka chwil, które szczególnie lubię."
  >
    {
      photos.length === 0 && (
        <p class="m-0 text-[15px] text-muted">Nie ma jeszcze zdjęć.</p>
      )
    }
    <div class="columns-2 gap-2 sm:gap-3">
      {
        photos.map((photo, i) => (
          <figure class="m-0 mb-2 flex break-inside-avoid flex-col gap-1.5 sm:mb-3 sm:gap-2">
            <button
              data-photo={i}
              data-large={photo.large}
              data-original={photo.original}
              data-caption={photo.caption}
              data-year={photo.year}
              aria-label={`Otwórz ${photo.caption}`}
              class="block cursor-zoom-in rounded-xl p-0"
            >
              <Image
                src={photo.src}
                alt={photo.caption}
                widths={[452, 904]}
                sizes="(max-width: 1000px) 50vw, 452px"
                class="w-full rounded-xl bg-surface grayscale-photo transition-[filter] duration-400 hover:filter-none"
              />
            </button>
            <figcaption class="flex justify-between gap-2 pb-1.5 text-xs text-muted sm:gap-3 sm:text-[13px]">
              <span>{photo.caption}</span>
              <span>{photo.year}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Main>
  <Footer />

  <PhotoViewer />
</Layout>
